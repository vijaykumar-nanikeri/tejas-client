{
  "compilerOptions": {
    "paths": {
      // Platform-level paths
      "icons/*": ["src/assets/icons/*"],
      "images/*": ["src/assets/images/*"],
      "styles/*": ["src/styles/*"],
      "constants/*": ["src/utils/constants/*"],
      "utils/*": ["src/utils/*"],
      "services/*": ["src/services/*"],
      "stores/*": ["src/stores/*"],
      "hooks/*": ["src/hooks/*"],
      "layout/*": ["src/layout/*"],
      "routing/*": ["src/routing/*"],
      "pages/*": ["src/pages/*"],
      "components/*": ["src/components/*"],
      "src/*": ["src/*"]
    }
  },
  "include": ["src"],
  "extends": "./tsconfig.base.json"
}
